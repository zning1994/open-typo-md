# Electron 的二进制下载在部分网络下需要镜像，用户可自行覆盖
strict-peer-dependencies=false

# 关掉安装脚本的「副作用缓存」。
#
# pnpm 默认会把 postinstall 的执行结果按包缓存进 store，下次直接复用而不重跑脚本。
# 这对 Electron 是个陷阱：只要有任何一次安装是在 ELECTRON_SKIP_BINARY_DOWNLOAD
# 环境下跑的，那份「没有二进制」的结果就会被缓存下来，之后所有共享同一 store 的
# 安装都会拿到它 —— 表现是 `electron.launch: Electron failed to install correctly`，
# 而 `pnpm install` 本身一切正常，极难排查。
#
# CI 里 check job 与 e2e job 共享 pnpm store 缓存，正好踩中这条。
# 代价只是每次重跑一遍安装脚本（本项目只有 electron 和 esbuild 两个），值得。
side-effects-cache=false
