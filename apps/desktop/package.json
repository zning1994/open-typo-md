    "@typo/export": "workspace:*",
    "@typo/i18n": "workspace:*",
    "@typo/markdown": "workspace:*",
    "@typo/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "vite": "^7.3.6"
  }
}
