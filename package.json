{
  "name": "open-typo-md",
  "version": "0.1.0",
  "private": true,
  "description": "开源的 Markdown 所见即所得编辑器",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "layers": "node scripts/check-layers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @typo/desktop build",
    "dev": "pnpm --filter @typo/desktop dev",
    "verify": "pnpm layers && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.0",
    "commonmark-spec": "^0.31.2",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
